// Moniversive Invariant Static (MIS) — deep root
// Creator: Chandler William Ferguson
// Compile: bin/misc <file>.mis --check --compact-letters
// Title: CLRTY MIS Verify · VectorAttest

module ClrtyMisVerifyVectorAttest {
  invariant letter_hash_bound: letter_hash_root != @0;
  invariant deep_root_moniversive: deep_root == moniversive;
  invariant settlement_chain: chain_id == 1202;
  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant kernel_is_misc: compiler_kernel == misc;
  invariant pack_vector_attest_bound: pack_bound == true;
  invariant catalog_backlink: mis_catalog_bound == true;

  invariant vector_attest_061: vector_attest_061_bound == true;
  invariant vector_attest_062: vector_attest_062_bound == true;
  invariant vector_attest_063: vector_attest_063_bound == true;
  invariant vector_attest_064: vector_attest_064_bound == true;
  invariant vector_attest_065: vector_attest_065_bound == true;
  invariant vector_attest_066: vector_attest_066_bound == true;
  invariant vector_attest_067: vector_attest_067_bound == true;
