  outcome assert_pack(payload: Bytes) {
    require payload != @0;
    constraint pack_bound == true;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
  }

  outcome assert_vector_attest_061(payload: Bytes) {
    require payload != @0;
    constraint vector_attest_061_bound == true;
    constraint chain_id == 1202;
  }

