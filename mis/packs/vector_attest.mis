// Title: CLRTY MIS Verify · VectorAttest

module ClrtyMisVerifyVectorAttest {

  embed gates 3..=6 {
    context: "VectorAttest pack on MIS domain mis_verify — CLRTY-1";
    ai: "Index via mis_code_index + moniversive_invariant_static_ML";
