  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant kernel_is_misc: compiler_kernel == misc;
  invariant pack_bytecode_hash_bound: pack_bound == true;
  invariant catalog_backlink: mis_catalog_bound == true;

  invariant bytecode_hash_021: bytecode_hash_021_bound == true;
  invariant bytecode_hash_022: bytecode_hash_022_bound == true;
  invariant bytecode_hash_023: bytecode_hash_023_bound == true;
  invariant bytecode_hash_024: bytecode_hash_024_bound == true;
